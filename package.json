{
  "name": "dissolve",
  "version": "0.0.1",
  "description": "An animation library for React Native: wrap any view and it dissolves, melts, peels or rebuilds itself. Skia snapshot, Reanimated 4 grains on the UI thread.",
  "author": "Rayan Selmi",
  "license": "MIT",
  "homepage": "https://github.com/dissolve-ui/dissolve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dissolve-ui/dissolve.git"
  },
  "bugs": {
    "url": "https://github.com/dissolve-ui/dissolve/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "skia",
    "reanimated",
    "animation",
    "particles",
    "dissolve"
  ],
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs",
    "test:cli": "node --test test/cli.test.mjs",
    "test:registry": "node --test test/registry.test.mjs test/theme.test.mjs",
    "test:package": "node --test test/package.test.mjs",
    "test:guard": "node --test test/no-pro.test.mjs",
    "build:package": "sh scripts/build-package.sh",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@tailwindcss/postcss": "^4.3.5",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "nativewind": "5.0.0-preview.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
