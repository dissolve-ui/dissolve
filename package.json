{
  "name": "dissolve",
  "version": "0.0.1",
  "description": "An animation library for React Native: wrap any view and it dissolves, melts, peels or rebuilds itself. Skia snapshot, Reanimated 4 grains on the UI thread.",
  "author": "Rayan Selmi",
  "license": "MIT",
  "homepage": "https://github.com/rs-4/dissolve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rs-4/dissolve.git"
  },
  "bugs": {
    "url": "https://github.com/rs-4/dissolve/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "skia",
    "reanimated",
    "animation",
    "particles",
    "dissolve"
  ],
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs",
    "test:cli": "node --test test/cli.test.mjs",
    "test:registry": "node --test test/registry.test.mjs test/theme.test.mjs",
    "test:package": "node --test test/package.test.mjs",
    "build:package": "sh scripts/build-package.sh",
    "check": "npm run typecheck && npm test",
    "web:stamp": "node scripts/build-web.mjs && node scripts/build-shadcn.mjs && node scripts/stamp-web.mjs && npm run web:seo",
    "web:seo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-seo.mjs",
    "web:registry": "node scripts/build-shadcn.mjs",
    "web:build": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "expo": "~57.0.6",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.24",
    "expo-glass-effect": "~57.0.5",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "esbuild": "^0.25.12",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
