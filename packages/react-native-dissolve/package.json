{
  "name": "react-native-dissolve",
  "version": "0.0.5",
  "description": "Turn any React Native view into dust. Skia snapshot, grains animated on the UI thread with Reanimated 4. Exits, entrances, gestures.",
  "author": "Rayan Selmi",
  "license": "MIT",
  "homepage": "https://github.com/rs-4/dissolve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rs-4/dissolve.git",
    "directory": "packages/react-native-dissolve"
  },
  "bugs": {
    "url": "https://github.com/rs-4/dissolve/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "skia",
    "reanimated",
    "animation",
    "particles",
    "dissolve",
    "disintegrate"
  ],
  "main": "lib/index.js",
  "module": "lib/index.js",
  "react-native": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.tsx",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "bin",
    "registry"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "expo-haptics": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "sh ../../scripts/build-package.sh"
  },
  "bin": {
    "react-native-dissolve": "bin/dissolve.mjs"
  }
}
