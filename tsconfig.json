{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "dissolve-ui": [
        "./src/dissolve"
      ],
      "@registry/*": [
        "./registry/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "packages/dissolve-ui/src",
    "packages/dissolve-ui/lib",
    "packages/dissolve-ui/registry",
    "registry/web"
  ]
}
