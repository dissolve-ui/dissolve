{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react-native-dissolve": [
        "./src/dissolve"
      ],
      "@registry/*": [
        "./registry/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "packages/react-native-dissolve/src",
    "packages/react-native-dissolve/lib",
    "packages/react-native-dissolve/registry"
  ]
}
